# ── Supabase (chiavi pubbliche per design, protette da RLS) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── AI (SOLO server-side) ─────────────────────────────────────────────────────
# NON usare variabili VITE_* per le API key: Vite le incorpora nel bundle
# pubblico del browser. La key di Gemini va impostata come secret della
# Edge Function:
#   supabase secrets set GEMINI_API_KEY=...
#   supabase functions deploy gemini-chat
